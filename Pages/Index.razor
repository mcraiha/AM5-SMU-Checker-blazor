                    useChecksum16 = !isArchive && isGigabyte;

                    if (useSha256)
                    {
                        using (var sha = SHA256.Create())
                        {
                            archiveChecksum = Convert.ToHexString(sha.ComputeHash(memoryStream));
                            biosChecksum = ComputeSHA256(biosBytes);
                        }
                    }
                    else if (useChecksum16)
                    {
                        archiveChecksum = ComputeChecksum16(memoryStream).ToString("X4");
                        biosChecksum = ComputeChecksum16(biosBytes).ToString("X4");
                    }
                }

                string board = (both.NameWords != null && both.NameWords.Length > 1) ? both.NameWords[1] : string.Empty;
                bool agesaFound = !string.IsNullOrEmpty(both.Agesa);
                string agesa = $"AGESA {both.Agesa}";
