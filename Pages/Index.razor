        foreach (var family in familyOrder)
        {
            var familyResults = results .Where(x => x.Definition.Name == family) .Take(2) .ToList();
            cpuDefinitions.TryGetValue(family, out var cpu);
            if (!familyResults.Any() && (cpu == null || cpu.FallbackPattern == null))
            {
                continue;
            }
            if (!firstGroup)
            {
                Log(sb, cc, "   ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─", PrintColor.DarkGray);
