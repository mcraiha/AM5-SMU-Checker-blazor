                }
                continue;
            }
            //Fallback Anzeige
            if (cpu != null && cpu.FallbackPattern != null)
            {
                bool found = cpu.FallbackPattern.Any(p => ContainsSequenceMasked(biosBytes, p, fallback));
                if (found)
                {
                    Log(sb, cc, $"   Found {cpu.FallbackName} CPUID but SMU detection failed\n   Program update may be necessary", PrintColor.DarkGray);
                }
                else
                {
                    Log(sb, cc, $"   Couldn't find any {cpu.FallbackName} SMU or CPUID - CPU may not be supported", PrintColor.DarkGray);
                }
            }                   
        }

        sb.AppendLine();
        Log(sb, cc, "                 Credits to RaINi, Reous and PatrickSchur                  ", PrintColor.Black, PrintColor.DarkBlue);

        if (!string.IsNullOrEmpty(archiveChecksum) &&
            !string.IsNullOrEmpty(biosChecksum))
