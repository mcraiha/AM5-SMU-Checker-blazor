                        Log(sb, cc, $"     {buildDate.PadRight(13)} {mbecVersion.PadRight(13)}{CenterText(both.AmiLastWord1, 12)} {ledVersion.PadLeft(12)} {BytesToKB(biosBytes.Length).ToString("#,0", Punkt).PadLeft(9)} KB");
                    }
                    else
                    {
