            int foundCount = 0;
            foreach (var smuOffset in oChipx)
            {
                if (smuOffset - 0x94 < 0 || smuOffset + 0x98 > biosBytes.Length)
                    continue;

                var span = biosBytes.AsSpan(smuOffset);
                int smuLen = BitConverter.ToInt32(biosBytes, smuOffset - 0x94);

                string date = $"{span[0x8E]:X2}.{span[0x8D]:X2}.20{span[0x8C]:X2}";
                string smuVer = $"{span[0x8F]:X2}.{span[0x90]:X2}.{span[0x91]:X2}";
                string fw = "FW" + Encoding.ASCII.GetString(biosBytes, smuOffset + 0x93, 5);

                Log(sb, cc, $"        Chipset Info:   {smuVer} | {fw} | {date} | ({BytesToKB(smuLen):N0} KB)", PrintColor.Gray);

                foundCount++;
                if (foundCount >= 2)
                    break;
            }
        }

        sb.AppendLine();

        Log(sb, cc, "        S Y S T E M    M A N A G E M E N T    U N I T    [ S M U ]         ", PrintColor.White, PrintColor.DarkBlue);
        Log(sb, cc, "    Version        Size        CPU/APU  Family               Offset        ", PrintColor.Black, PrintColor.DarkCyan);

        // +++++++++++++++++    SMU Suche    +++++++++++++++++++++++++++++++++++++++++++++++
        var smuDefinition = new FirmwareDefinition
        {
            Pattern = "24 50 53 31",
            SmuValidation = true,

            Ids = new Dictionary<byte, CpuDefinition>
            {
                [0x54] = new() { Name = "Raphael/X      7xx0 CPU", LengthFrom14 = false, 
                FallbackName = "Raphael", FallbackPattern = new[] {new byte[] {0x12,0x60,0x0A,0x05,0x80}, new byte[] {0x13,0x60,0x0A,0x05,0x80}}},
                [0x4C] = new() { Name = "Phoenix/2      8xx0 APU", LengthFrom14 = false,
                FallbackName = "Phoenix", FallbackPattern = new[] {new byte[] {0x52,0x70,0x0A,0x05,0x80}, new byte[] {0x80,0x70,0x0A,0x05,0x80}}},
                [0x62] = new() { Name = "Granite Ridge  9xx0 CPU", LengthFrom14 = false,
                FallbackName = "Granite Ridge", FallbackPattern = new[] {new byte[] {0x40,0x40,0x0B,0x15,0x80 },new byte[] {0x41,0x40,0x0B,0x15,0x80}}},
                [0x65] = new() { Name = "Krackan/2    AI xxx APU", LengthFrom14 = true,
                FallbackName = "Krackan Point", FallbackPattern = new[] {new byte[] {0x80,0x60,0x0B,0x16,0x80 },new byte[] {0x00,0x60,0x0B,0x15,0x80}}},

                [0x5D] = new() { Name = "Strix Point  AI xxx APU", LengthFrom14 = true },
                [0x64] = new() { Name = "Strix Halo   AI xxx APU", LengthFrom14 = true } 
            }
            
        };

        var results = ScanFirmware(biosBytes, smuDefinition);


        // +++++++++++++++++    Ausgabe    ++++++++++++++++++++++++++++++++++++++++++++++++
        byte[] fallback = { 0xFF, 0xFF, 0xFF, 0x00, 0xFF };
        var cpuDefinitions = smuDefinition.Ids.Values.ToDictionary(x => x.Name);
        var familyOrder = smuDefinition.Ids.Values.Select(x => x.Name);
