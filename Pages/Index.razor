            biosName = filename;
            biosBytes = memoryStream.ToArray();
        }

        // ##########################   Agesa, Name, Version    ###################################################### 
        CombinedResult? both = null;
        try
        {
            both = AgesaLzmaScanner.TryFindAgesaAndAmiInLzma(biosBytes);
            if (both != null)
            {
                string oem = (both.NameWords != null && both.NameWords.Length > 0) ? both.NameWords[0] : string.Empty;
                {
                    bool isGigabyte = oem.Contains("Gigabyte", StringComparison.OrdinalIgnoreCase);
                    bool isShaBoard = oem.Contains("ASRock", StringComparison.OrdinalIgnoreCase) ||
                                        oem.Contains("ASUSTeK", StringComparison.OrdinalIgnoreCase) ||
                                        oem.Contains("Micro-Star", StringComparison.OrdinalIgnoreCase) ||
                                        oem.Contains("Sapphire", StringComparison.OrdinalIgnoreCase);

